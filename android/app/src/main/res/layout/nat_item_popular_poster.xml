<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="145dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.almezo.servers.nat.RatioFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nat_bg_poster"
        android:clipToOutline="true"
        android:duplicateParentState="true"
        android:foreground="@drawable/nat_fg_poster_focus_red">

        <ImageView
            android:id="@+id/pop_poster_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/pop_poster_rating"
            style="@style/NatText.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/nat_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="★ 0.0"
            android:textColor="@color/nat_gold"
            android:textSize="12sp"
            android:visibility="gone" />
    </com.almezo.servers.nat.RatioFrameLayout>

    <TextView
        android:id="@+id/pop_poster_title"
        style="@style/NatText.ExtraBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />
</LinearLayout>
