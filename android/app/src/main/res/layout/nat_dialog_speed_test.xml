<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:padding="20dp">

    <!-- تمرير: محتوى النافذة أطول من الشاشة على الهاتف في الوضع الأفقي وعلى شاشات TV
         القصيرة، وبدونه يُقطع زرّا "بدء الفحص" و"إغلاق" ولا يمكن الوصول إليهما -->
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/dialog_speed_card"
        android:layout_width="860dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/nat_bg_dialog_card"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="20dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp">

        <!-- الترويسة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_player_speed"
                app:tint="#FF06B6D4" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_speed_title"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="قياس سرعة الإنترنت"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/dialog_speed_subtitle"
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="فحص سرعة الاتصال وتحديد جودة البث الموصى بها"
                    android:textColor="#FF94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dialog_speed_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/nat_btn_icon"
                android:contentDescription="إغلاق"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_xmark"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- عمودان بالعرض: العدّاد على جهة، والنتائج والأزرار على الجهة الأخرى
             (عمود واحد طويل لا يناسب شاشات التلفاز والهاتف الأفقي) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <!-- العدّاد بإبرة ومقياس غير خطي، ومراحل الفحص، ورسم تذبذب السرعة الحي -->
        <LinearLayout
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/nat_bg_device_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <com.almezo.servers.nat.SpeedGaugeView
                android:id="@+id/speed_gauge"
                android:layout_width="240dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_speed_status"
                style="@style/NatText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="جاهز لبدء الفحص"
                android:textColor="#FFCBD5E1"
                android:textSize="14sp" />

            <!-- مراحل الفحص: تضيء كل نقطة عند بدء مرحلتها وتصير خضراء عند اكتمالها -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/phase_ping"
                    style="@style/NatText.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● الاستجابة"
                    android:textColor="#FF475569"
                    android:textSize="12.5sp" />

                <TextView
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="—"
                    android:textColor="#FF334155" />

                <TextView
                    android:id="@+id/phase_dl"
                    style="@style/NatText.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● التحميل"
                    android:textColor="#FF475569"
                    android:textSize="12.5sp" />

                <TextView
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="—"
                    android:textColor="#FF334155" />

                <TextView
                    android:id="@+id/phase_stable"
                    style="@style/NatText.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● الثبات"
                    android:textColor="#FF475569"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <com.almezo.servers.nat.SpeedSparkView
                android:id="@+id/speed_spark"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/tv_speed_warning"
                style="@style/NatText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#FFF59E0B"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- العمود الثاني: المؤشرات والتوصية والأزرار -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <!-- شبكة المؤشرات الثلاثية: تحميل / استجابة / تقلب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/label_metric_dl"
                    style="@style/NatText"
                    android:maxLines="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التحميل"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_metric_dl"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-- Mbps"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/label_metric_ping"
                    style="@style/NatText"
                    android:maxLines="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الاستجابة"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_metric_ping"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-- ms"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/label_metric_jitter"
                    style="@style/NatText"
                    android:maxLines="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التقلب"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_metric_jitter"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-- ms"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- بطاقة التوصية الذكية بجودة البث -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/nat_bg_auth_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_recommend_badge"
                style="@style/NatText.Black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 في انتظار الفحص..."
                android:textColor="#FF38BDF8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_recommend_desc"
                style="@style/NatText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="اضغط على زر الفحص لمعرفة جودة البث الأنسب لسرعتك الحالية."
                android:textColor="#FF94A3B8"
                android:textSize="12.5sp" />

            <!-- ما يتحمله الاتصال من الجودات: أخضر مناسب، أصفر على الحافة، رمادي غير مناسب -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/chip_q_sd" style="@style/NatText.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:paddingStart="12dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="4dp" android:text="SD" android:textColor="#FF64748B" android:textSize="12sp" />
                <TextView android:id="@+id/chip_q_hd" style="@style/NatText.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:paddingStart="12dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="4dp" android:text="HD" android:textColor="#FF64748B" android:textSize="12sp" />
                <TextView android:id="@+id/chip_q_fhd" style="@style/NatText.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:paddingStart="12dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="4dp" android:text="FHD" android:textColor="#FF64748B" android:textSize="12sp" />
                <TextView android:id="@+id/chip_q_4k" style="@style/NatText.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="4dp" android:text="4K" android:textColor="#FF64748B" android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_speed_history"
                style="@style/NatText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#FF64748B"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- أزرار الإجراءات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_speed_start"
                style="@style/NatText.Bold"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/nat_btn_speed"
                android:focusable="true"
                android:text="بدء الفحص"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_speed_close_bottom"
                style="@style/NatText.Bold"
                android:layout_width="130dp"
                android:layout_height="52dp"
                android:background="@drawable/nat_btn_secondary"
                android:focusable="true"
                android:text="إغلاق"
                android:textColor="#FFCBD5E1"
                android:textSize="16sp" />
        </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
