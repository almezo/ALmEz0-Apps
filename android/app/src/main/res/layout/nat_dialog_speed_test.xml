<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:padding="20dp">

    <!-- تمرير: محتوى النافذة أطول من الشاشة على الهاتف في الوضع الأفقي وعلى شاشات TV
         القصيرة، وبدونه يُقطع زرّا "بدء الفحص" و"إغلاق" ولا يمكن الوصول إليهما -->
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/dialog_speed_card"
        android:layout_width="660dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/nat_bg_dialog_card"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="28dp">

        <!-- الترويسة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_player_speed"
                app:tint="#FF06B6D4" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_speed_title"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="قياس سرعة الإنترنت"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/dialog_speed_subtitle"
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="فحص سرعة الاتصال وتحديد جودة البث الموصى بها"
                    android:textColor="#FF94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dialog_speed_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/nat_btn_icon"
                android:contentDescription="إغلاق"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_xmark"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- عداد السرعة الرقمي وخط التقدم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/nat_bg_device_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_speed_val"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="#FF06B6D4"
                    android:textSize="54sp" />

                <TextView
                    android:id="@+id/tv_speed_unit"
                    style="@style/NatText.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Mbps"
                    android:textColor="#FF94A3B8"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_speed_status"
                style="@style/NatText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="جاهز لبدء الفحص"
                android:textColor="#FFCBD5E1"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress_speed"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/nat_intro_track" />
        </LinearLayout>

        <!-- شبكة المؤشرات الثلاثية: تحميل / استجابة / تقلب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/label_metric_dl"
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سرعة التحميل"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_metric_dl"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-- Mbps"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/label_metric_ping"
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الاستجابة (Ping)"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_metric_ping"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-- ms"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/label_metric_jitter"
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التقلب (Jitter)"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_metric_jitter"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-- ms"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- بطاقة التوصية الذكية بجودة البث -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:background="@drawable/nat_bg_auth_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_recommend_badge"
                style="@style/NatText.Black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 في انتظار الفحص..."
                android:textColor="#FF38BDF8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_recommend_desc"
                style="@style/NatText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="اضغط على زر الفحص لمعرفة جودة البث الأنسب لسرعتك الحالية."
                android:textColor="#FF94A3B8"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- أزرار الإجراءات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_speed_start"
                style="@style/NatText.Bold"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/nat_btn_speed"
                android:focusable="true"
                android:text="بدء الفحص"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_speed_close_bottom"
                style="@style/NatText.Bold"
                android:layout_width="130dp"
                android:layout_height="52dp"
                android:background="@drawable/nat_btn_secondary"
                android:focusable="true"
                android:text="إغلاق"
                android:textColor="#FFCBD5E1"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
