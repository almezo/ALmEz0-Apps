<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة التفاصيل (#movie-details-screen و #series-details-screen) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nat_bg_main"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/det_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nat_scrim_details" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/nat_navbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="28dp"
            android:paddingEnd="48dp"
            android:paddingBottom="20dp">

            <!-- عمود الملصق وزر المشاهدة -->
            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.almezo.servers.nat.RatioFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nat_bg_poster">

                    <ImageView
                        android:id="@+id/det_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </com.almezo.servers.nat.RatioFrameLayout>

                <LinearLayout
                    android:id="@+id/det_btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/nat_btn_watch"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/fa_play"
                        app:tint="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/det_btn_play_text"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مشاهدة الآن"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- عمود المعلومات -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="44dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/det_title"
                        style="@style/NatText.Black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="40sp" />

                    <ImageButton
                        android:id="@+id/det_btn_fav"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/nat_btn_social"
                        android:contentDescription="المفضلة"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/fa_heart"
                        app:tint="#FFCBD5E1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/det_meta"
                    style="@style/NatText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/nat_soft"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/det_rating"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nat_badge"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/nat_gold"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/det_btn_trailer"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/nat_row_item"
                        android:focusable="true"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="▶  الإعلان"
                        android:textSize="17sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- للمسلسلات: شريط المواسم -->
                <HorizontalScrollView
                    android:id="@+id/det_seasons_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/det_seasons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ScrollView
                    android:id="@+id/det_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/det_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/NatText.ExtraBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="القصة"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/det_plot"
                            style="@style/NatText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.35"
                            android:textColor="@color/nat_soft"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/det_people"
                            style="@style/NatText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/nat_muted"
                            android:textSize="16sp" />
                    </LinearLayout>
                </ScrollView>

                <!-- للمسلسلات: قائمة الحلقات -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/det_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/det_progress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/nat_gold" />
</FrameLayout>
