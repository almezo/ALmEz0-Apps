<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nat_bg_main"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/det_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nat_scrim_details" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/nat_navbar" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/det_main_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="20dp"
                android:paddingEnd="44dp"
                android:paddingBottom="40dp">

                <!-- 1. بطاقة العمل الرئيسية (Hero Card) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- عمود الملصق وزر المشاهدة المباشر -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.almezo.servers.nat.RatioFrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/nat_bg_poster">

                            <ImageView
                                android:id="@+id/det_poster"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop" />
                        </com.almezo.servers.nat.RatioFrameLayout>

                        <LinearLayout
                            android:id="@+id/det_btn_play"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/nat_btn_watch"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="10dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/fa_play"
                                app:tint="#FFFFFFFF" />

                            <TextView
                                android:id="@+id/det_btn_play_text"
                                style="@style/NatText.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="مشاهدة الآن"
                                android:textSize="19sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- عمود المعلومات والتفاصيل -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/det_title"
                                style="@style/NatText.Black"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textSize="36sp" />

                            <ImageButton
                                android:id="@+id/det_btn_fav"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/nat_btn_social"
                                android:contentDescription="المفضلة"
                                android:focusable="true"
                                android:padding="14dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/fa_heart"
                                app:tint="#FFCBD5E1" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/det_meta"
                            style="@style/NatText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/nat_soft"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/det_rating"
                                style="@style/NatText.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/nat_badge"
                                android:paddingStart="14dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="6dp"
                                android:text="★ 0.0"
                                android:textColor="@color/nat_gold"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/det_btn_trailer"
                                style="@style/NatText.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/nat_btn_secondary"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingStart="18dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="8dp"
                                android:text="▶  مشاهدة الإعلان"
                                android:textColor="#FFFFFFFF"
                                android:textSize="15sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- للمسلسلات: شريط المواسم -->
                        <HorizontalScrollView
                            android:id="@+id/det_seasons_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:scrollbars="none"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/det_seasons"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <!-- القصة والممثلين والمخرج -->
                        <LinearLayout
                            android:id="@+id/det_story_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/NatText.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="القصة"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/det_plot"
                                style="@style/NatText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="@color/nat_soft"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/det_people"
                                style="@style/NatText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingMultiplier="1.25"
                                android:textColor="@color/nat_muted"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <!-- للمسلسلات: قائمة الحلقات -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/det_episodes"
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:layout_marginTop="12dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. قسم أعمال رائجة للمشاهدة الآن (Popular Section) -->
                <LinearLayout
                    android:id="@+id/det_popular_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/fa_fire" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/det_popular_title"
                                style="@style/NatText.ExtraBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="أفلام رائجة للمشاهدة الآن"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/det_popular_subtitle"
                                style="@style/NatText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الأعمال الأكثر مشاهدة وتقييماً"
                                android:textColor="@color/nat_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/det_popular_view_all"
                            style="@style/NatText.ExtraBold"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/nat_btn_secondary"
                            android:drawableStart="@drawable/fa_arrow_left"
                            android:drawablePadding="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="عرض الكل"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- شريط الكروت الأفقي -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/det_popular_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- زر الصعود للأعلى الدائري الفاخر (Floating Scroll To Top) -->
    <ImageButton
        android:id="@+id/det_btn_scroll_top"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="32dp"
        android:background="@drawable/nat_btn_scroll_top"
        android:contentDescription="الصعود للأعلى"
        android:focusable="true"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/fa_arrow_up"
        android:visibility="gone"
        app:tint="#FFFFFFFF" />

    <ProgressBar
        android:id="@+id/det_progress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/nat_gold" />
</FrameLayout>
