<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- رسالة المستخدم -->
    <LinearLayout
        android:id="@+id/ai_msg_user_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/nat_bg_ai_user_msg"
        android:maxWidth="560dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_msg_user_text"
            style="@style/NatText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- رسالة المساعد الذكي -->
    <LinearLayout
        android:id="@+id/ai_msg_bot_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|end"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nat_btn_ai"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/fa_sparkles"
            app:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/nat_bg_ai_bot_msg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_msg_bot_text"
                style="@style/NatText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#FFFFFFFF"
                android:textIsSelectable="false"
                android:textSize="17sp" />

            <!-- بطاقات الأعمال والقنوات التي ذكرها المساعد من السيرفر (تفتح صفحة الفيلم/المسلسل أو تشغّل القناة) -->
            <LinearLayout
                android:id="@+id/ai_msg_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- مصادر بحث Google التي اعتمد عليها الرد -->
            <LinearLayout
                android:id="@+id/ai_msg_sources_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    style="@style/NatText.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="المصادر:"
                    android:textColor="@color/nat_muted"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ai_msg_sources"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
