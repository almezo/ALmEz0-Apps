<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- رسالة المستخدم -->
    <LinearLayout
        android:id="@+id/ai_msg_user_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/nat_bg_ai_user_msg"
        android:maxWidth="520dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_msg_user_text"
            style="@style/NatText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- رسالة المساعد الذكي -->
    <LinearLayout
        android:id="@+id/ai_msg_bot_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|end"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nat_btn_ai"
            android:padding="7dp"
            android:src="@drawable/fa_sparkles"
            app:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/nat_bg_ai_bot_msg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/ai_msg_bot_text"
                style="@style/NatText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <!-- بطاقة التوصية المباشرة (تشغيل فوري للقناة أو الفيلم أو المسلسل) -->
            <LinearLayout
                android:id="@+id/ai_msg_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/nat_bg_device_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ai_card_poster"
                    android:layout_width="56dp"
                    android:layout_height="76dp"
                    android:background="@drawable/nat_bg_poster"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ai_card_title"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ai_card_subtitle"
                        style="@style/NatText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/nat_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/ai_card_btn_play"
                    style="@style/NatText.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/nat_btn_watch"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="تشغيل الآن ▶"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
