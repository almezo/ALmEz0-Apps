<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة الحلقة في شبكة الحلقات (4 أعمدة من اليمين لليسار): صورة 16:9، ثم العنوان، ثم المدة مع أيقونة الساعة.
     زر التشغيل الأحمر يظهر فوق الصورة عند التركيز فقط، كما في نسخة الكمبيوتر. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nat_bg_episode_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="@drawable/nat_fg_episode_focus"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <com.almezo.servers.nat.RatioFrameLayout
        android:id="@+id/ep_thumb_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF0B0E14">

        <ImageView
            android:id="@+id/ep_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- تعتيم خفيف وزر التشغيل عند التركيز -->
        <View
            android:id="@+id/ep_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/ep_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/nat_circle_play_btn"
            android:elevation="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:layout_marginStart="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/fa_play"
                app:tint="#FFFFFFFF" />
        </FrameLayout>
    </com.almezo.servers.nat.RatioFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/ep_title"
            style="@style/NatText.Black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/fa_clock"
                app:tint="#FF94A3B8" />

            <TextView
                android:id="@+id/ep_duration"
                style="@style/NatText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF94A3B8"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
