<?xml version="1.0" encoding="utf-8"?>
<!-- شاشتا الدخول (#auth1-screen كود السيرفر ، #auth2-screen بيانات الحساب) بنفس بطاقة .auth-card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nat_bg_app"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:background="@drawable/nat_bg_auth_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="45dp"
                android:paddingTop="48dp"
                android:paddingEnd="45dp"
                android:paddingBottom="48dp">

                <ImageView
                    android:id="@+id/auth_logo"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="ALmEz0"
                    android:scaleType="fitCenter"
                    android:src="@drawable/almezo_logo" />

                <TextView
                    android:id="@+id/auth_title"
                    style="@style/NatText.Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:maxLines="1"
                    android:text="مشغل الميزو - ALmEz0"
                    android:textSize="32sp" />

                <!-- الخطوة 1: كود السيرفر -->
                <LinearLayout
                    android:id="@+id/auth_step_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NatText.ExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="أدخل كود السيرفر للمتابعة"
                        android:textSize="19sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <EditText
                            android:id="@+id/auth_code"
                            style="@style/NatText.ExtraBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/nat_bg_input"
                            android:hint="مثال: 123"
                            android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingStart="60dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="20dp"
                            android:textAlignment="viewStart"
                            android:textSize="20sp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/fa_desktop"
                            app:tint="@color/nat_muted" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/auth_btn_connect"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nat_btn_gold"
                        android:padding="20dp"
                        android:stateListAnimator="@null"
                        android:text="الاتصال بالسيرفر"
                        android:textColor="#FF000000"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- الخطوة 2: اسم المستخدم وكلمة المرور -->
                <LinearLayout
                    android:id="@+id/auth_step_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <EditText
                            android:id="@+id/auth_user"
                            style="@style/NatText.ExtraBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/nat_bg_input"
                            android:hint="اسم المستخدم"
                            android:imeOptions="actionNext|flagNoExtractUi|flagNoFullscreen"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="60dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="20dp"
                            android:textAlignment="viewStart"
                            android:textSize="20sp" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/fa_user"
                            app:tint="@color/nat_muted" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <EditText
                            android:id="@+id/auth_pass"
                            style="@style/NatText.ExtraBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/nat_bg_input"
                            android:hint="كلمة المرور"
                            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="60dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="60dp"
                            android:paddingBottom="20dp"
                            android:textAlignment="viewStart"
                            android:textSize="20sp" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/fa_lock"
                            app:tint="@color/nat_muted" />

                        <ImageButton
                            android:id="@+id/auth_toggle_pass"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/nat_btn_social"
                            android:contentDescription="إظهار/إخفاء كلمة المرور"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fa_eye"
                            app:tint="@color/nat_muted" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/auth_btn_login"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nat_btn_gold"
                        android:padding="20dp"
                        android:stateListAnimator="@null"
                        android:text="تسجيل الدخول"
                        android:textColor="#FF000000"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- زر الرجوع الدائري (.btn-home-return) أعلى يمين البطاقة -->
            <ImageButton
                android:id="@+id/auth_btn_back"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="top|start"
                android:layout_margin="18dp"
                android:background="@drawable/nat_btn_back_circle"
                android:contentDescription="الرجوع"
                android:padding="19dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_arrow_right"
                app:tint="@color/nat_nav_home" />
        </FrameLayout>

        <TextView
            style="@style/NatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="ALmEz0 - سيرفرات الميزو - جميع الحقوق محفوظة © 2026"
            android:textColor="@color/nat_soft"
            android:textSize="16sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/auth_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/nat_gold"
        android:visibility="gone" />
</FrameLayout>
