<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="780dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/nat_bg_dialog_card"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="28dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <!-- الترويسة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/fa_sliders"
                app:tint="@color/nat_gold" />

            <TextView
                style="@style/NatText.Black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="اختيار نمط الجهاز ونظام التحكم"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/dialog_device_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/nat_btn_icon"
                android:contentDescription="إغلاق"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_xmark"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- شبكة الخيارات الثلاثة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1. شاشة لمس -->
            <LinearLayout
                android:id="@+id/card_mode_touch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/fa_mobile_screen_button"
                    app:tint="@color/nat_gold" />

                <TextView
                    style="@style/NatText.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="هاتف أو تابلت"
                    android:textSize="18sp" />

                <TextView
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/nat_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="شاشة لمس"
                    android:textColor="@color/nat_gold"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_mode_touch"
                    style="@style/NatText.ExtraBold"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/nat_btn_gold"
                    android:clickable="false"
                    android:text="تفعيل النمط"
                    android:textColor="#FF000000"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 2. ريموت كنترول / تلفزيون -->
            <LinearLayout
                android:id="@+id/card_mode_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/fa_tv"
                    app:tint="#FF8B5CF6" />

                <TextView
                    style="@style/NatText.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="شاشة أندرويد / رسيفر"
                    android:textSize="17sp" />

                <TextView
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_badge_red"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="ريموت كنترول"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_mode_tv"
                    style="@style/NatText.ExtraBold"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/nat_btn_gold"
                    android:clickable="false"
                    android:text="تفعيل النمط"
                    android:textColor="#FF000000"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 3. كمبيوتر / كيبورد وماوس -->
            <LinearLayout
                android:id="@+id/card_mode_desktop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/nat_bg_device_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/fa_desktop"
                    app:tint="#FF3B82F6" />

                <TextView
                    style="@style/NatText.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="كمبيوتر أو لابتوب"
                    android:textSize="18sp" />

                <TextView
                    style="@style/NatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/nat_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="ماوس وكيبورد"
                    android:textColor="#FF3B82F6"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_mode_desktop"
                    style="@style/NatText.ExtraBold"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/nat_btn_gold"
                    android:clickable="false"
                    android:text="تفعيل النمط"
                    android:textColor="#FF000000"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
