<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/nat_bg_dialog_card"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="26dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/fa_sliders"
            app:tint="@color/nat_gold" />

        <TextView
            style="@style/NatText.ExtraBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الترتيب والعرض"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/sort_btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/nat_btn_social"
            android:contentDescription="إغلاق"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fa_xmark"
            app:tint="@color/nat_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#22FFFFFF" />

    <!-- Radio Options -->
    <RadioGroup
        android:id="@+id/sort_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/sort_opt_default"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/nat_accent"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="الترتيب الافتراضي"
            android:textSize="17sp" />

        <RadioButton
            android:id="@+id/sort_opt_added"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/nat_accent"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="المضافة حديثاً"
            android:textSize="17sp" />

        <RadioButton
            android:id="@+id/sort_opt_asc"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/nat_accent"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="الاسم (أ - ي)"
            android:textSize="17sp" />

        <RadioButton
            android:id="@+id/sort_opt_desc"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/nat_accent"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="الاسم (ي - أ)"
            android:textSize="17sp" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#22FFFFFF" />

    <!-- Checkbox: إخفاء الأسماء -->
    <CheckBox
        android:id="@+id/sort_chk_hide_names"
        style="@style/NatText.Bold"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:buttonTint="@color/nat_accent"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="إخفاء أسماء القنوات والأفلام من الملصقات"
        android:textColor="@color/nat_soft"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="18dp"
        android:background="#22FFFFFF" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sort_btn_cancel"
            style="@style/NatText.Bold"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/nat_btn_secondary"
            android:focusable="true"
            android:text="إلغاء"
            android:textColor="@color/nat_soft"
            android:textSize="16sp" />

        <Button
            android:id="@+id/sort_btn_save"
            style="@style/NatText.ExtraBold"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/nat_btn_danger"
            android:focusable="true"
            android:text="حفظ وتطبيق"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
