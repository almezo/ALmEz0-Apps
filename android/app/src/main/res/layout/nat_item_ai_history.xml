<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/nat_bg_history_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ai_history_title"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="اقترح لي أفضل فيلم سهرة أكشن..."
            android:textColor="#FFF1F5F9"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ai_history_date"
            style="@style/NatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="19/9 1:02"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/ai_history_btn_delete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/nat_btn_social"
        android:contentDescription="حذف المحادثة"
        android:focusable="true"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/fa_trash"
        app:tint="#EF4444" />
</LinearLayout>
