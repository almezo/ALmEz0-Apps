<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة فيلم/مسلسل/قناة: صندوق 2:3 بزوايا 12dp مقصوصة بنعومة + إطار تركيز أحمر + عنوان بسطر واحد -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <com.almezo.servers.nat.RatioFrameLayout
        android:id="@+id/poster_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nat_bg_poster"
        android:clipToOutline="true"
        android:duplicateParentState="true"
        android:foreground="@drawable/nat_fg_poster_focus_red">

        <ImageView
            android:id="@+id/poster_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- تقييم الفيلم/المسلسل أعلى يسار الملصق -->
        <TextView
            android:id="@+id/poster_rating"
            style="@style/NatText.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="7dp"
            android:background="@drawable/nat_bg_poster_rating"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/nat_gold"
            android:textDirection="ltr"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/poster_fav"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/fa_star"
            android:tint="@color/nat_gold"
            android:visibility="gone" />
    </com.almezo.servers.nat.RatioFrameLayout>

    <TextView
        android:id="@+id/poster_title"
        style="@style/NatText.ExtraBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#E6000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
</LinearLayout>
