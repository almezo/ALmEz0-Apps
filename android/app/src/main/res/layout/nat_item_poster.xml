<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة فيلم/مسلسل/قناة: صندوق 2:3 بزوايا 10 + عنوان بسطرين (21 extrabold كما في الويب على أندرويد) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingTop="6dp"
    android:paddingEnd="5dp"
    android:paddingBottom="12dp">

    <com.almezo.servers.nat.RatioFrameLayout
        android:id="@+id/poster_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nat_bg_poster"
        android:duplicateParentState="true"
        android:foreground="@drawable/nat_fg_poster_focus">

        <ImageView
            android:id="@+id/poster_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/poster_fav"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/fa_star"
            android:visibility="gone"
            android:tint="@color/nat_gold" />
    </com.almezo.servers.nat.RatioFrameLayout>

    <TextView
        android:id="@+id/poster_title"
        style="@style/NatText.ExtraBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:shadowColor="#E6000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textSize="21sp" />
</LinearLayout>
