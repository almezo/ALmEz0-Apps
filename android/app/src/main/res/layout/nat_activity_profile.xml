<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nat_bg_app"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <include layout="@layout/nat_navbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="20dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/NatText.Black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:text="معلومات الحساب"
                android:textSize="32sp" />

            <!-- بطاقة الملف الشخصي الفاخرة (.profile-card) -->
            <LinearLayout
                android:layout_width="660dp"
                android:layout_height="wrap_content"
                android:background="@drawable/nat_bg_dialog_card"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingTop="28dp"
                android:paddingEnd="36dp"
                android:paddingBottom="28dp">

                <!-- ترويسة البطاقة: اسم المستخدم + شارة "متصل" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/almezo_logo" />

                    <TextView
                        android:id="@+id/prof_username"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/prof_status"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingStart="14dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="5dp"
                        android:text="متصل"
                        android:textColor="#FF22C55E"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#24FFFFFF" />

                <!-- 1. السيرفر -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NatText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="السيرفر"
                        android:textColor="@color/nat_muted"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/prof_server"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/nat_gold"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- 2. حالة الحساب -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NatText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="حالة الحساب"
                        android:textColor="@color/nat_muted"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/prof_type"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حساب نشط ✓"
                        android:textColor="#FF22C55E"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- 3. الحد الأقصى للاتصالات -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NatText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الحد الأقصى للاتصالات"
                        android:textColor="@color/nat_muted"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/prof_max_conn"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- 4. الاتصالات النشطة حالياً -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NatText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الاتصالات النشطة حالياً"
                        android:textColor="@color/nat_muted"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/prof_active_conn"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/nat_gold"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- 5. تاريخ بدء الاشتراك -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NatText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="تاريخ بدء الاشتراك"
                        android:textColor="@color/nat_muted"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/prof_created_at"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- 6. تاريخ انتهاء الاشتراك -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NatText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="تاريخ انتهاء الاشتراك"
                        android:textColor="@color/nat_muted"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/prof_exp_at"
                        style="@style/NatText.ExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/nat_gold"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- الفوتر الاجتماعي الأصلي -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/prof_social_call"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/nat_btn_social_call"
                    android:contentDescription="اتصال"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fa_phone"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/prof_social_fb"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/nat_btn_social_fb"
                    android:contentDescription="فيسبوك"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fa_b_facebook_f"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/prof_social_wa"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/nat_btn_social_wa"
                    android:contentDescription="واتساب"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fa_b_whatsapp"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                style="@style/NatText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textDirection="ltr"
                android:text="ALmEz0 - سيرفرات الميزو - جميع الحقوق محفوظة © 2026"
                android:textColor="@color/nat_soft"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
