<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة عمل/قناة داخل رد مساعد الميزو: الملصق، الاسم، النوع والتقييم، وزر فتح الصفحة أو التشغيل -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/nat_bg_device_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ai_card_poster"
        android:layout_width="58dp"
        android:layout_height="80dp"
        android:background="@drawable/nat_bg_poster"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ai_card_title"
            style="@style/NatText.ExtraBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/ai_card_subtitle"
            style="@style/NatText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/nat_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ai_card_action"
        style="@style/NatText.ExtraBold"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/nat_btn_watch"
        android:duplicateParentState="true"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />
</LinearLayout>
