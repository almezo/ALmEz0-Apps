<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة تنزيل واحدة: الصورة، الاسم، الحالة، شريط التقدّم، الحجم والسرعة والوقت المتبقي، والأزرار.
     تُستعمل في صفحة التنزيلات وفي صندوق التنزيل المنبثق. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/nat_bg_download_card"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="114dp"
        android:background="@drawable/nat_bg_poster"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/dl_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dl_title"
            style="@style/NatText.Black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/dl_subtitle"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/nat_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dl_status"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/dl_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/nat_dl_progress" />

        <TextView
            android:id="@+id/dl_stats"
            style="@style/NatText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textAlignment="viewStart"
            android:textColor="@color/nat_soft"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dl_btn_primary"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/nat_btn_icon"
        android:focusable="true"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/fa_pause"
        app:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/dl_btn_secondary"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/nat_btn_icon"
        android:contentDescription="إلغاء"
        android:focusable="true"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/fa_xmark"
        app:tint="#FFF87171" />
</LinearLayout>
