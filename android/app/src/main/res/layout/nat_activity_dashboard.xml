<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة التحكم (#dashboard-screen): الترويسة + ثلاث بطاقات + التذييل + زر مساعد الميزو العائم -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nat_bg_app"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/nat_navbar" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- عرض الحاوية يُحسب في الكود: أقصى 1480 كما في .dash-cards-wrapper -->
            <LinearLayout
                android:id="@+id/dash_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:paddingStart="30dp"
                android:paddingEnd="30dp">

                <include
                    android:id="@+id/card_live"
                    layout="@layout/nat_dash_card" />

                <Space
                    android:layout_width="28dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/card_movies"
                    layout="@layout/nat_dash_card" />

                <Space
                    android:layout_width="28dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/card_series"
                    layout="@layout/nat_dash_card" />
            </LinearLayout>
        </FrameLayout>

        <!-- التذييل (.dash-footer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/foot_call"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/nat_btn_social_call"
                    android:contentDescription="اتصال"
                    android:focusable="true"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fa_phone"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/foot_facebook"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/nat_btn_social_fb"
                    android:contentDescription="فيسبوك"
                    android:focusable="true"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fa_b_facebook_f"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/foot_whatsapp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/nat_btn_social_wa"
                    android:contentDescription="واتساب"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fa_b_whatsapp"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                style="@style/NatText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALmEz0 - سيرفرات الميزو - جميع الحقوق محفوظة © 2026"
                android:textColor="@color/nat_soft"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- الزر العائم لمساعد الميزو الذكي (#aiFloatingTrigger) -->
    <LinearLayout
        android:id="@+id/dash_btn_ai"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/nat_btn_ai"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/fa_sparkles"
            app:tint="#FFFFFFFF" />

        <TextView
            style="@style/NatText.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مساعد الميزو"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
