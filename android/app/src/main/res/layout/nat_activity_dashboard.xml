<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة التحكم (#dashboard-screen): الترويسة + ثلاث بطاقات + التذييل -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nat_bg_app"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <include layout="@layout/nat_navbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- عرض الحاوية يُحسب في الكود: أقصى 1480 كما في .dash-cards-wrapper -->
        <LinearLayout
            android:id="@+id/dash_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <include
                android:id="@+id/card_live"
                layout="@layout/nat_dash_card" />

            <Space
                android:layout_width="28dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/card_movies"
                layout="@layout/nat_dash_card" />

            <Space
                android:layout_width="28dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/card_series"
                layout="@layout/nat_dash_card" />
        </LinearLayout>
    </FrameLayout>

    <!-- التذييل (.dash-footer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/foot_call"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/nat_btn_social"
                android:contentDescription="اتصال"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_phone"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/foot_facebook"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/nat_btn_social"
                android:contentDescription="فيسبوك"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_b_facebook_f"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/foot_whatsapp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/nat_btn_social"
                android:contentDescription="واتساب"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fa_b_whatsapp"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <TextView
            style="@style/NatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALmEz0 - سيرفرات الميزو - جميع الحقوق محفوظة © 2026"
            android:textColor="@color/nat_soft"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
