<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ExoPlayer Video Surface (TextureView for rock-solid stability) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Buffering Progress Indicator (Matching Black Background & Professional Spinner) -->
    <ProgressBar
        android:id="@+id/pb_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="#5240d8"
        android:visibility="gone" />

    <!-- Double-Tap Seek Pill Feedback (+10s / -10s) -->
    <TextView
        android:id="@+id/tv_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_button"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Unlock Floating Button (Visible only when screen is locked) -->
    <ImageButton
        android:id="@+id/btn_unlock_screen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_circle_purple"
        android:contentDescription="Unlock Screen"
        android:src="@drawable/ic_player_unlock"
        android:visibility="gone" />

    <!-- FULL CONTROLS OVERLAY (Matching Image 3 Exactly) -->
    <FrameLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000">

        <!-- ================= TOP BAR ================= -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical">

            <!-- Left: Purple Round Back Button + Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:nextFocusRight="@+id/btn_cast"
                    android:nextFocusDown="@+id/btn_play_pause"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_player_back" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="400dp"
                    android:text="ALmEz0 Player"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_live_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_red"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="LIVE مباشر"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Right: Cast, Lock, Settings Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_cast"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btn_back"
                    android:nextFocusRight="@+id/btn_lock"
                    android:nextFocusDown="@+id/btn_play_pause"
                    android:contentDescription="Cast"
                    android:src="@drawable/ic_player_cast" />

                <ImageButton
                    android:id="@+id/btn_lock"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btn_cast"
                    android:nextFocusRight="@+id/btn_settings"
                    android:nextFocusDown="@+id/btn_play_pause"
                    android:contentDescription="Lock"
                    android:src="@drawable/ic_player_lock" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btn_lock"
                    android:nextFocusDown="@+id/btn_play_pause"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_player_settings" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ================= VERTICAL BRIGHTNESS SLIDER (STRICT PHYSICAL LEFT) ================= -->
        <LinearLayout
            android:id="@+id/layout_brightness_slider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Brightness"
                android:src="@drawable/ic_player_sun" />

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="170dp"
                android:background="#33FFFFFF">

                <View
                    android:id="@+id/bar_brightness_fill"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_gravity="bottom"
                    android:background="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ================= VERTICAL VOLUME SLIDER (STRICT PHYSICAL RIGHT) ================= -->
        <LinearLayout
            android:id="@+id/layout_volume_slider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Volume"
                android:src="@drawable/ic_player_speaker" />

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="170dp"
                android:background="#33FFFFFF">

                <View
                    android:id="@+id/bar_volume_fill"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_gravity="bottom"
                    android:background="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ================= CENTER PLAYBACK CONTROLS ================= -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rewind_10"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_circle_button"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_back"
                android:nextFocusRight="@+id/btn_play_pause"
                android:nextFocusDown="@+id/seek_bar"
                android:contentDescription="Rewind 10 seconds"
                android:scaleType="fitCenter"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_player_rewind_10" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_circle_button"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_settings"
                android:nextFocusLeft="@+id/btn_rewind_10"
                android:nextFocusRight="@+id/btn_forward_10"
                android:nextFocusDown="@+id/seek_bar"
                android:contentDescription="Play/Pause"
                android:scaleType="fitCenter"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_player_pause" />

            <ImageButton
                android:id="@+id/btn_forward_10"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="40dp"
                android:background="@drawable/bg_circle_button"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_settings"
                android:nextFocusLeft="@+id/btn_play_pause"
                android:nextFocusDown="@+id/seek_bar"
                android:contentDescription="Forward 10 seconds"
                android:scaleType="fitCenter"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_player_forward_10" />
        </LinearLayout>

        <!-- ================= BOTTOM SEEK & ACTION BUTTONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="20dp">

            <!-- Seek Bar Row with Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_play_pause"
                    android:nextFocusDown="@+id/btn_aspect"
                    android:progressBackgroundTint="#4DFFFFFF"
                    android:progressTint="#FFFFFF"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="00:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Bottom Action Buttons Row: Aspect Ratio & Speed (1x) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Aspect Ratio Button -->
                <LinearLayout
                    android:id="@+id/btn_aspect"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/seek_bar"
                    android:nextFocusRight="@+id/btn_speed"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_player_aspect_ratio" />

                    <TextView
                        android:id="@+id/tv_aspect_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Aspect Ratio"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Speed (1x) Button -->
                <LinearLayout
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btn_aspect"
                    android:nextFocusUp="@+id/seek_bar"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_player_speed" />

                    <TextView
                        android:id="@+id/tv_speed_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Speed (1x)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ================= SETTINGS SIDE DRAWER OVERLAY (Matching Image 4 Exactly) ================= -->
    <FrameLayout
        android:id="@+id/settings_drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settings_drawer"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#121622"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Drawer Header: Purple Back Button + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <ImageButton
                    android:id="@+id/btn_close_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_purple"
                    android:contentDescription="Close Settings"
                    android:src="@drawable/ic_player_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26FFFFFF" />

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- SECTION 1: Video Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_track_video" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video Tracks"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_video_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="#1AFFFFFF" />

                    <!-- SECTION 2: Audio Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_track_audio" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audio Tracks"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_audio_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="#1AFFFFFF" />

                    <!-- SECTION 3: Subtitle Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_track_subtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subtitle Tracks"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_subtitle_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_no_subtitles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:text="No subtitle found for this video"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
