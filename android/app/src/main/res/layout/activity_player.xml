<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layoutDirection="ltr">

    <!-- ExoPlayer Video Surface
         SurfaceView بدل TextureView: مع TextureView يُنسخ كل إطار مفكوك إلى نسيج (texture) في
         كرت الشاشة ثم يُركَّب عبر خيط رسم التطبيق في كل إطار، وهي تكلفة إضافية مستمرة وسبب
         معروف لسقوط الإطارات والتقطيع على صناديق التلفاز الضعيفة. SurfaceView يسمح لمفكك
         الترميز العتادي بالكتابة مباشرة إلى طبقة عرض مستقلة (zero-copy) بلا نسخ ولا تركيب،
         وهو الخيار الذي توصي به Media3 للأداء. آمن هنا لأن الـ PlayerView لا يُحرَّك ولا
         يُطبَّق عليه أي تحجيم أو شفافية؛ أوضاع الأبعاد (Fit/Fill/Zoom) تغيّر حجم الإطار فقط.
         للرجوع للسلوك السابق عند أي مشكلة: app:surface_type="texture_view" -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />


    <!-- Double-Tap Seek Pill Feedback (+10s / -10s) -->
    <TextView
        android:id="@+id/tv_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_button"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Unlock Floating Button (Visible only when screen is locked) -->
    <ImageButton
        android:id="@+id/btn_unlock_screen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_circle_purple"
        android:contentDescription="Unlock Screen"
        android:src="@drawable/ic_player_unlock"
        android:visibility="gone" />

    <!-- FULL CONTROLS OVERLAY (Matching Image 3 Exactly) -->
    <FrameLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000">

        <!-- ================= TOP BAR ================= -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical">

            <!-- Left: Purple Round Back Button + Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_player_back" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="400dp"
                    android:text="ALmEz0 Player"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_live_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_red"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="LIVE مباشر"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Right: Cast, Lock, Settings Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_cast"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:contentDescription="Cast"
                    android:src="@drawable/ic_player_cast"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btn_lock"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:contentDescription="Lock"
                    android:src="@drawable/ic_player_lock" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_button"
                    android:focusable="true"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_player_settings" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ================= VERTICAL BRIGHTNESS SLIDER (STRICT PHYSICAL LEFT) ================= -->
        <LinearLayout
            android:id="@+id/layout_brightness_slider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Brightness"
                android:src="@drawable/ic_player_sun" />

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="170dp"
                android:background="#33FFFFFF">

                <View
                    android:id="@+id/bar_brightness_fill"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_gravity="bottom"
                    android:background="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ================= VERTICAL VOLUME SLIDER (STRICT PHYSICAL RIGHT) ================= -->
        <LinearLayout
            android:id="@+id/layout_volume_slider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Volume"
                android:src="@drawable/ic_player_speaker" />

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="170dp"
                android:background="#33FFFFFF">

                <View
                    android:id="@+id/bar_volume_fill"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_gravity="bottom"
                    android:background="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- ================= CENTER PLAYBACK CONTROLS ================= -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rewind_10"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_circle_button"
                android:focusable="true"
                android:contentDescription="Rewind 10 seconds"
                android:scaleType="fitCenter"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_player_rewind_10" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_circle_button"
                android:focusable="true"
                android:contentDescription="Play/Pause"
                android:scaleType="fitCenter"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_player_pause" />

            <ImageButton
                android:id="@+id/btn_forward_10"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="40dp"
                android:background="@drawable/bg_circle_button"
                android:focusable="true"
                android:contentDescription="Forward 10 seconds"
                android:scaleType="fitCenter"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_player_forward_10" />
        </LinearLayout>

        <!-- ================= BOTTOM SEEK & ACTION BUTTONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="20dp">

            <!-- Seek Bar Row with Timestamps -->
            <LinearLayout
                android:id="@+id/layout_seekbar_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:focusable="true"
                    android:minHeight="6dp"
                    android:maxHeight="6dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:progressBackgroundTint="#4DFFFFFF"
                    android:progressTint="#FFE50914"
                    android:thumb="@drawable/nat_seek_thumb"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="00:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Bottom Action Buttons Row: Aspect Ratio & Speed (1x) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Aspect Ratio Button -->
                <LinearLayout
                    android:id="@+id/btn_aspect"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_player_aspect_ratio" />

                    <TextView
                        android:id="@+id/tv_aspect_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="الأبعاد"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Speed (1x) Button -->
                <LinearLayout
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_player_speed" />

                    <TextView
                        android:id="@+id/tv_speed_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="السرعة (1x)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- الحلقة/القناة السابقة (يظهر عند وجود قائمة تشغيل) -->
                <LinearLayout
                    android:id="@+id/btn_prev_item"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_player_rewind" />

                    <TextView
                        android:id="@+id/tv_prev_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/tajawal_bold"
                        android:text="الحلقة السابقة"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- الحلقة/القناة التالية (يظهر عند وجود قائمة تشغيل) -->
                <LinearLayout
                    android:id="@+id/btn_next_item"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_player_forward" />

                    <TextView
                        android:id="@+id/tv_next_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/tajawal_bold"
                        android:text="الحلقة التالية"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- مؤشر التحميل: وحده في منتصف الشاشة أثناء بطء الإنترنت (زر التشغيل يختفي في هذه اللحظة) -->
    <ProgressBar
        android:id="@+id/pb_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFE50914"
        android:visibility="gone" />

    <!-- بطاقة القناة عند التنقل بين القنوات: الشعار والرقم والاسم وبرنامج الآن/التالي -->
    <LinearLayout
        android:id="@+id/osd_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/nat_osd_bg"
        android:gravity="center_vertical"
        android:maxWidth="620dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/osd_logo"
            android:layout_width="84dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/osd_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_badge_red"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/osd_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/tajawal_extrabold"
                    android:maxWidth="420dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/osd_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/tajawal_bold"
                android:maxWidth="480dp"
                android:maxLines="1"
                android:textColor="#FFF59E0B"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/osd_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/tajawal_bold"
                android:maxWidth="480dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- استئناف المشاهدة من آخر نقطة، مع خيار البدء من البداية -->
    <LinearLayout
        android:id="@+id/resume_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/nat_osd_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resume_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_restart"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/tajawal_extrabold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="من البداية ↺"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- الحلقة التالية عند انتهاء الحلقة: عدّ تنازلي ثم تشغيل تلقائي -->
    <LinearLayout
        android:id="@+id/next_panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_margin="28dp"
        android:background="@drawable/nat_osd_bg"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="الحلقة التالية"
            android:textColor="#FFF59E0B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_extrabold"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_next_now"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/nat_btn_watch"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/tajawal_extrabold"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_next_cancel"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/tajawal_extrabold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="إلغاء"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= SETTINGS SIDE DRAWER OVERLAY (Matching Image 4 Exactly) ================= -->
    <FrameLayout
        android:id="@+id/settings_drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settings_drawer"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#121622"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Drawer Header: Purple Back Button + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <ImageButton
                    android:id="@+id/btn_close_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_purple"
                    android:contentDescription="Close Settings"
                    android:src="@drawable/ic_player_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="الإعدادات"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26FFFFFF" />

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- SECTION 1: Video Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_track_video" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="جودة الفيديو"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_video_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="#1AFFFFFF" />

                    <!-- SECTION 2: Audio Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_track_audio" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الصوت واللغة"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_audio_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="#1AFFFFFF" />

                    <!-- SECTION 3: Subtitle Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_track_subtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الترجمة"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_subtitle_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_no_subtitles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:text="لا توجد ترجمة لهذا الفيديو"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
