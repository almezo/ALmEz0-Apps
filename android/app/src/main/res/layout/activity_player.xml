<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ExoPlayer Video Surface (TextureView for rock-solid stability) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Buffering Progress Indicator -->
    <ProgressBar
        android:id="@+id/pb_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="#f4c242"
        android:visibility="gone" />

    <!-- Gesture HUD for Volume & Brightness Floating Feedback -->
    <LinearLayout
        android:id="@+id/hud_volume_brightness"
        android:layout_width="160dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:background="#CC0a0d14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hud_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="HUD Icon"
            android:src="@drawable/ic_player_volume" />

        <ProgressBar
            android:id="@+id/hud_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#f4c242" />

        <TextView
            android:id="@+id/hud_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="50%"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Double Tap Seek Feedback Indicator (Left or Right) -->
    <TextView
        android:id="@+id/tv_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC161b22"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="+10 ثواني"
        android:textColor="#f4c242"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Locked Mode Floating Button (Visible only when controls are locked) -->
    <ImageButton
        android:id="@+id/btn_unlock_screen"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="#CC0a0d14"
        android:contentDescription="فتح قفل الشاشة"
        android:src="@drawable/ic_player_lock"
        android:visibility="gone" />

    <!-- Fullscreen Controls Overlay -->
    <RelativeLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:background="#D90a0d12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="رجوع"
                android:focusable="true"
                android:src="@drawable/ic_player_back" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ALmEz0 Video Player"
                android:textColor="#ffffff"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Subtitles Button -->
            <ImageButton
                android:id="@+id/btn_subtitles"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="الترجمة"
                android:focusable="true"
                android:src="@drawable/ic_player_subtitle" />

            <!-- Audio Tracks / Dubbing Button -->
            <ImageButton
                android:id="@+id/btn_audio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="مسار الصوت والدبلجة"
                android:focusable="true"
                android:src="@drawable/ic_player_audio" />

            <!-- Video Quality & Specs Info Button -->
            <ImageButton
                android:id="@+id/btn_quality_info"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="معلومات الفيديو"
                android:focusable="true"
                android:src="@drawable/ic_player_info" />

            <!-- Screen Lock Button -->
            <ImageButton
                android:id="@+id/btn_lock"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="قفل الشاشة"
                android:focusable="true"
                android:src="@drawable/ic_player_unlock" />

            <!-- Brand Tag -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#1f2937"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="ALmEz0"
                android:textColor="#4caf50"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Controls (Rewind, Play/Pause, Forward) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rewind_10"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="10 ثواني للخلف"
                android:focusable="true"
                android:src="@drawable/ic_player_rewind" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="تشغيل / إيقاف"
                android:focusable="true"
                android:src="@drawable/ic_player_play" />

            <ImageButton
                android:id="@+id/btn_forward_10"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="10 ثواني للأمام"
                android:focusable="true"
                android:src="@drawable/ic_player_forward" />
        </LinearLayout>

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true"
            android:background="#D90a0d12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#cbd5e1"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:max="1000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:progressTint="#f4c242"
                android:thumbTint="#f4c242" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#cbd5e1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_aspect"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="#22ffffff"
                android:focusable="true"
                android:minWidth="60dp"
                android:text="16:9"
                android:textColor="#f4c242"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
