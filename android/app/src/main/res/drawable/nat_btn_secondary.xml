<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF4B5563"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2.5dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1F2937"/>
            <corners android:radius="14dp"/>
        <stroke android:width="2.5dp" android:color="#FFFFFFFF"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF374151"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#26FFFFFF"/>
        </shape>
    </item>
</selector>