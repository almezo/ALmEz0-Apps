<?xml version="1.0" encoding="utf-8"?>
<!-- .btn-watch-movie: أحمر، ويضيء بوضوح عند وصول تركيز الريموت إليه (لون أفتح وإطار أبيض أعرض) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="14dp"/>
            <gradient android:angle="270" android:startColor="#FFFF4B4B" android:endColor="#FFFF1F1F"/>
            <stroke android:width="3dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp"/>
            <gradient android:angle="270" android:startColor="#FFFF4B4B" android:endColor="#FFFF1F1F"/>
            <stroke android:width="3dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp"/>
            <solid android:color="#FFE50914"/>
        </shape>
    </item>
</selector>
