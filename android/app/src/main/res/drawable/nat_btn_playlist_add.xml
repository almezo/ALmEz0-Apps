<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="135" android:startColor="#FF4CAF50" android:endColor="#FF2E7D32" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="135" android:startColor="#FF388E3C" android:endColor="#FF1B5E20" />
            <stroke android:width="2dp" android:color="#FF81C784" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="135" android:startColor="#FF4CAF50" android:endColor="#FF2E7D32" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
