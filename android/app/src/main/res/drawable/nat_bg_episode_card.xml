<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#33141926" />
            <stroke android:width="3dp" android:color="#FFE50914" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#44141926" />
            <stroke android:width="3dp" android:color="#FFE50914" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#D00D121D" />
            <stroke android:width="1.2dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
