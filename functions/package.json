{
  "name": "almez0-servers-functions",
  "description": "Firebase Cloud Functions for AlMeZ0 Servers - Secure WhatsApp notifications via CallMeBot API",
  "scripts": {
    "lint": "eslint --ext .js .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:generateAiReply,functions:sendWhatsAppNotification,functions:pushBroadcastNotification,functions:weeklyProfitRollover,functions:logTransactionDeleted,functions:sendScheduledNotifications,functions:subscriptionExpiryReminders,functions:logEvent,functions:cleanupActivityLogs",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
