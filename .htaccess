# =========================================================
# ALmEz0 Servers - Production Apache & cPanel Configuration
# =========================================================

# 1. Prevent Directory Browsing
Options -Indexes

# 1b. Never serve development files, even if an upload puts them here by mistake.
#     Found public on 2026-09-29: old functions/index.js (CallMeBot key), scratch/*.py (Firebase tokens),
#     .vscode/sftp.json, firestore.rules, package.json.
#     Do NOT add plain .json here: version.json, servers.json and channel_logos.json are fetched by the apps.
<FilesMatch "(^\.|\.(py|pyc|gs|md|bat|ps1|sh|log|sql|zip|rar|7z|bak|env|ini|rules)$|^(package(-lock)?|firebase|firestore\.indexes|capacitor\.config|tsconfig)\.json$|^error_log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 "^/(\.git|\.github|\.vscode|\.agents|\.claude|node_modules|functions|scratch|scripts|android|ios|electron|dist-electron|dist-hosting|www|IPTV-m3u-Web-Player-ez-main)(/|$)"
</IfModule>

# 2. Enable CORS (Cross-Origin Resource Sharing)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Range"
    Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
</IfModule>

# 3. Add Media & Video MIME Types
<IfModule mod_mime.c>
    AddType application/vnd.apple.mpegurl .m3u8
    AddType video/mp2t .ts
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType application/json .json
    AddType application/manifest+json .webmanifest
    AddType image/x-icon .ico
</IfModule>

# 4. Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# 5. PHP Settings (if mod_php is available)
<IfModule mod_php7.c>
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
